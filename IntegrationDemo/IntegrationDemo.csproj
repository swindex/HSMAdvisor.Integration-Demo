<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HSMAdvisor.Integration demo. Talks to the separately installed HSMAdvisor.exe over the
    integration named pipe (the same way the Mastercam hooks do) - no HSMAdvisorCore.dll is loaded.

    Builds for both frameworks HSMAdvisor.Integration ships for:
      * net48           - .NET Framework hosts (e.g. Mastercam 2020-2026)
      * net8.0-windows  - .NET (Core) hosts (e.g. Mastercam 2027 on .NET 10)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IntegrationDemo</RootNamespace>
    <AssemblyName>HSMAdvisor.Integration-Demo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>HSMAdvisor.Integration Demo</Product>
    <Company>HSMAdvisor Inc.</Company>
    <Copyright>© Eldar Gerfanov, HSMAdvisor Inc.</Copyright>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- HSMAdvisor.Integration ships a net48 and a net8.0 build -->
    <IntegrationTfm Condition="$(TargetFramework.StartsWith('net4'))">net48</IntegrationTfm>
    <IntegrationTfm Condition="!$(TargetFramework.StartsWith('net4'))">net8.0</IntegrationTfm>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HSMAdvisor.Integration">
      <HintPath>..\lib\$(IntegrationTfm)\HSMAdvisor.Integration.dll</HintPath>
    </Reference>
    <!-- HSMAdvisor.Integration is built against Newtonsoft.Json 13.0.3 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
